rules_version = '2';

// Reglas de seguridad de Firestore para World Cup Collector UES.
// Pega esto en: Firebase Console → Firestore Database → Reglas.
//
// Idea: cada usuario solo puede leer/escribir SU PROPIO documento
// (users/{uid}), identificado por su uid de Firebase Auth. Nadie puede
// leer ni modificar los datos de otro usuario.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Config de la app editable solo por la cuenta admin (UID fijo, ver
    // public/js/utils/admin.js). Lectura pública para cualquier usuario
    // logueado (ej. config/live la necesita todo el mundo para ver la
    // transmisión). Esta regla es la única fuente de verdad real de
    // autorización — el chequeo en el frontend es solo para no mostrar la
    // UI de edición a quien no es admin, no un mecanismo de seguridad.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'EDh7heVm8xd1wUWuIXjwnH6yKe43';
    }

    // Bloquea todo lo demás por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
