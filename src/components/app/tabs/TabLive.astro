---

// Responsabilidad: pestaña "FWC EN VIVO" — aviso de calidad, reproductor

---
<section id="tab-live" class="tab-section">
  <div class="section-header">
    <h2>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:6px"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
      FÚTBOL
      <span class="live-badge-header">EN VIVO</span>
    </h2>
  </div>

  <div class="live-quality-notice">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
    <span id="live-notice-text">Sigue La Liga, la Premier League y la Champions League en <strong>Full HD 1080P</strong>.</span>
  </div>

  <div class="live-body">

    <div class="live-channel-switch" role="group" aria-label="Seleccionar señal">
      <span class="live-channel-switch-label">Señal:</span>
      <button type="button" class="live-channel-btn active" data-channel="1" data-src="https://sudamericaplay.sbs/canal_8112/cza_dsports.html">
        <span class="live-channel-dot"></span> <span class="live-channel-label">Opción 1</span>
      </button>
      <button type="button" class="live-channel-btn" data-channel="2" data-src="https://sudamericaplay.sbs/canal_8112/dsports2.html">
        <span class="live-channel-dot"></span> <span class="live-channel-label">Opción 2</span>
      </button>
    </div>

    <div class="live-player-wrap">
      <iframe
        id="live-iframe"
        data-src="https://sudamericaplay.sbs/canal_8112/cza_dsports.html"
        allow="fullscreen; autoplay"
        allowfullscreen
        scrolling="no"
        title="Fútbol en vivo — DirecTV Sports">
      </iframe>
    </div>
  </div>
</section>
